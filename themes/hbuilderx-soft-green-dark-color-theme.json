    {
      "scope": "keyword.operator.arithmetic.js,keyword.operator.comparison.js,keyword.operator.arithmetic.ts,keyword.operator.comparison.ts",
      "settings": { "foreground": "#22d3ee" }
    },
    {
      "scope": "invalid.deprecated",
      "settings": { "foreground": "#d4d9d2" }
    },
    {
      "scope": "invalid.illegal",
      "settings": { "foreground": "#d4d9d2" }
    },
    {
      "scope": "string source",
      "settings": { "foreground": "#1e2419" }
    },
    {
      "scope": "String constant",
      "settings": { "foreground": "#9ca3af" }
    },
    {
      "scope": "string variable",
      "settings": { "foreground": "#60a5fa" }
    },
    {
      "scope": "string.regexp",
      "settings": { "foreground": "#fb923c" }
    },
    {
      "scope": [
        "string.regexp.character-class",
        "string.regexp constant.character.escaped",
        "string.regexp source.ruby.embedded",
        "string.regexp string.regexp.arbitrary-repitition"
      ],
      "settings": { "foreground": "#fb923c" }
    },
    {
      "scope": "string.regexp constant.character.escape",
      "settings": { "foreground": "#dc2626" }
    },
    {
      "scope": "text source",
      "settings": { "foreground": "#1e2419" }
    },
    {
      "scope": "function name",
      "settings": { "foreground": "#fbbf24" }
    },
    {
      "scope": "function argument",
      "settings": { "foreground": "#bef264" }
    },
    {
      "scope": "support.function",
      "settings": { "foreground": "#ec4899" }
    },
    {
      "scope": "support.constant",
      "settings": { "foreground": "#fb923c" }
    },
    {
      "scope": "support.variable",
      "settings": { "foreground": "#22c55e" }
    },
    {
      "scope": "entity.name.type.namespace",
      "settings": { "foreground": "#fcd34d" }
    },
    {
      "scope": "support.class, entity.name.type.class",
      "settings": { "foreground": "#fcd34d" }
    },
    {
      "scope": "entity.name.class.identifier.namespace.type",
      "settings": { "foreground": "#fcd34d" }
    },
    {
      "scope": "entity.name.class",
      "settings": { "foreground": "#60a5fa" }
    },
    {
      "scope": "entity.name.type",
      "settings": { "foreground": "#fcd34d" }
    },
    {
      "scope": "support.constant.color.w3c-standard-color-name.css,support.constant.color.w3c-standard-color-name.scss",
      "settings": { "foreground": "#fb923c" }
    },
    {
      "scope": "support.constant.color.w3c-standard-color-name.css,entity.other.attribute-name.class.css",
      "settings": { "foreground": "#fb923c" }
    },
    {
      "scope": "support.type.vendored.property-name.css",
      "settings": { "foreground": "#22d3ee" }
    },
    {
      "scope": "punctuation.definition.template-expression.begin.js,punctuation.definition.template-expression.end.js,punctuation.definition.template-expression.begin.ts,punctuation.definition.template-expression.end.ts",
      "settings": { "foreground": "#4ade80" }
    },
    {
      "scope": "support.module.node.js,support.type.object.module.js,support.module.node.js,support.module.node.ts,support.type.object.module.ts,support.module.node.ts",
      "settings": { "foreground": "#fcd34d" }
    },
    {
      "scope": "variable.other.readwrite.js,meta.object-literal.key.js,support.variable.property.js,support.variable.object.process.js,variable.other.readwrite.ts,meta.object-literal.key.ts,support.variable.property.ts,support.variable.object.process.ts",
      "settings": { "foreground": "#4ade80" }
    },
    {
      "scope": "support.constant.json.js,support.constant.json.ts",
      "settings": { "foreground": "#fb923c" }
    },
    {
      "scope": "keyword.operator.expression.instanceof.js,keyword.operator.expression.instanceof.ts",
      "settings": { "foreground": "#4ade80" }
    },
    {
      "scope": "keyword.operator.expression.typeof.js,keyword.operator.expression.typeof.ts",
      "settings": { "foreground": "#4ade80" }
    },
    {
      "scope": "support.type.object.console.js,support.type.object.console.ts",
      "settings": { "foreground": "#4ade80" }
    },
    {
      "scope": "entity.name.function.js,support.function.console.js,entity.name.function.ts,support.function.console.ts",
      "settings": { "foreground": "#60a5fa" }
    },
    {
      "scope": "keyword.operator.js,keyword.operator.ts",
      "settings": { "foreground": "#22d3ee" }
    }
  ]
}