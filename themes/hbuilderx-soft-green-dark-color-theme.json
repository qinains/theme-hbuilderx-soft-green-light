  "tokenColors": [
    {
      "scope": "console.error",
      "settings": { "foreground": "#ef4444" }
    },
    {
      "scope": "console.input",
      "settings": { "foreground": "#22c55e" }
    },
    {
      "scope": "console.prompt",
      "settings": { "foreground": "#a855f7", "fontStyle": "bold" }
    },
    {
      "scope": "console.warning",
      "settings": { "foreground": "#f59e0b" }
    },
    {
      "scope": "console.debug",
      "settings": { "foreground": "#3b82f6" }
    },
    {
      "scope": "hyperlink",
      "settings": { "foreground": "#60a5fa" }
    },
    {
      "scope": "markup.deleted",
      "settings": { "foreground": "#1e2419" }
    },
    {
      "scope": "markup.inserted",
      "settings": { "foreground": "#d4d9d2" }
    },
    {
      "scope": "markup.changed",
      "settings": { "foreground": "#252a20" }
    },
    {
