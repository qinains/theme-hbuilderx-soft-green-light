    },
    {
      "scope": "constant.other.placeholder.py",
      "settings": { "foreground": "#dc2626" }
    },
    {
      "scope": "entity",
      "settings": { "foreground": "#f97316" }
    },
    {
      "scope": "entity.name.type",
      "settings": { "foreground": "#8b5cf6" }
    },
    {
      "scope": "entity.other.inherited-class",
      "settings": { "foreground": "#d4d9d2" }
