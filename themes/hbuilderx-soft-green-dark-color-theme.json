    {
      "scope": "keyword.operator.expression.delete.js,keyword.operator.expression.in.js,keyword.operator.expression.of.js,keyword.operator.expression.instanceof.js,keyword.operator.new.js,keyword.operator.expression.typeof.js,keyword.operator.expression.void.js",
      "settings": { "foreground": "#4ade80", "fontStyle": "bold" }
    },
    {
      "scope": "meta.selector",
      "settings": { "foreground": "#4ade80", "fontStyle": "bold" }
    },
    {
      "scope": "string | punctuation.definition.string",
      "settings": { "foreground": "#a8d5ba" }
    },
    {
      "scope": "string, entity.other.inherited-class",
      "settings": { "foreground": "#a8d5ba" }
    },
    {
      "scope": "Number",
      "settings": { "foreground": "#c4b5fd" }
    },
    {
      "scope": "support",
      "settings": { "foreground": "#22c55e" }
    },
    {
      "scope": "variable",
      "settings": { "foreground": "#4ade80" }
    },
    {
      "scope": "variable.parameter",
      "settings": { "foreground": "#84cc16" }
    },
    {
      "scope": "keyword.operator",
      "settings": { "foreground": "#4ade80" }
    },
    {
      "scope": "keyword.operator.logical.js,keyword.operator.logical.ts",
      "settings": { "foreground": "#ec4899" }
